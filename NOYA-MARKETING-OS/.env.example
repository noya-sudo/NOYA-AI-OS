# NOYA Marketing OS — environment template. Names and placeholders ONLY.
# Copy to .env.local (git-ignored) for local work. Real secrets live in Supabase Edge Function secrets or n8n
# credentials, never in files. See docs/integrations.md and docs/security-model.md.

# --- Executor safety flags (defaults deny). Database kill switches must ALSO be enabled. ---
MOS_ENV=development
MOS_EXTERNAL_WRITES_ENABLED=false
MOS_SPEND_ENABLED=false

# --- Supabase: "NOYA Marketing OS" project (never NOYA HQ) ---
MOS_SUPABASE_URL=
MOS_SUPABASE_PUBLISHABLE_KEY=
MOS_SUPABASE_PROJECT_REF=
# Secret, CI / migrations only:
MOS_SUPABASE_DB_URL=

# --- Workers: per-role JWTs (role claim mos_agent / mos_executor / mos_monitor / mos_dispatcher), n8n credentials ---
MOS_AGENT_JWT=
MOS_EXECUTOR_JWT=
MOS_MONITOR_JWT=

# --- Alerts (D6): Resend, Marketing OS's own send-only key and sender ---
MOS_RESEND_API_KEY=
MOS_ALERT_FROM=NOYA Marketing OS <mos-alerts@noyaconcierge.com>
MOS_DISPATCH_TOKEN=

# --- AI (D7): separate Claude key / budget from HQ ---
MOS_ANTHROPIC_API_KEY=
MOS_AI_MONTHLY_BUDGET_USD=30

# --- Research (Phase 3) ---
MOS_FIRECRAWL_API_KEY=
MOS_SERPER_API_KEY=

# --- Instagram / Meta (Phase 5 read; write tokens are created only in Phase 7 / 8) ---
MOS_META_APP_ID=
MOS_META_APP_SECRET=
MOS_IG_BUSINESS_ACCOUNT_ID=
MOS_IG_READ_TOKEN=
MOS_META_AD_ACCOUNT_ID=
MOS_META_ADS_READ_TOKEN=

# --- LinkedIn Company Page (Phase 5 read; subject to LinkedIn approval) ---
MOS_LINKEDIN_CLIENT_ID=
MOS_LINKEDIN_CLIENT_SECRET=
MOS_LINKEDIN_ORGANIZATION_URN=
MOS_LINKEDIN_READ_TOKEN=

# --- Google (Phase 5, read only) ---
MOS_GA4_PROPERTY_ID=
MOS_GA4_SERVICE_ACCOUNT=

# --- NOYA HQ hand-off (Phase 6; needs a separately approved HQ intake) ---
MOS_HQ_HANDOFF_URL=
MOS_HQ_HANDOFF_SIGNING_SECRET=

# NOYA Marketing OS: environment template.
# Copy to .env.local (git-ignored). NEVER put real values in this file. See docs/environment.md.
# Platform credentials do not exist yet; leaving them blank is correct.

# --- Safety flags: defaults deny. All three must allow before any real external write. ---
MKT_ENV=development
MKT_EXTERNAL_WRITES_ENABLED=false
MKT_SPEND_ENABLED=false

# --- Supabase: Marketing OS project (NOT NOYA HQ) ---
MKT_SUPABASE_URL=
MKT_SUPABASE_PUBLISHABLE_KEY=
MKT_SUPABASE_SERVICE_ROLE_KEY=
MKT_SUPABASE_DB_URL=
MKT_SUPABASE_PROJECT_REF=

# --- AI and research (existing accounts) ---

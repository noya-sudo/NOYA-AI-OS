<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.yourviral7.service</string>
  <key>ProgramArguments</key><array><string>__DIR__/yv7.sh</string><string>start</string></array>
  <key>WorkingDirectory</key><string>__DIR__</string>
  <key>EnvironmentVariables</key><dict><key>YV7_HOME</key><string>__DIR__</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>StandardOutPath</key><string>__DIR__/LOGS/service.out</string>
  <key>StandardErrorPath</key><string>__DIR__/LOGS/service.err</string>
  <key>LowPriorityIO</key><true/>
</dict></plist>
